# AgentShield Security Engine Configuration
PROJECT_NAME="AgentShield Security Engine"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=false
FAIL_CLOSED=true

# Security Thresholds
RISK_THRESHOLD_BLOCK=0.85
RISK_THRESHOLD_ESCROW=0.65
RISK_THRESHOLD_WARN=0.40

# Model Armor Settings
MODEL_ARMOR_ENABLED=true
MODEL_ARMOR_PROVIDER="google_cloud_model_armor"
MODEL_ARMOR_VERSION="model-armor-v1.0+gemma-edge"
